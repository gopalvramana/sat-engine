DB_URL=jdbc:postgresql://localhost:5432/satengine
DB_USERNAME=postgres
DB_PASSWORD=yourpassword

# Neon sync — used by the "Sync to Neon" button in the admin pipeline dashboard.
# Copy your Neon JDBC URL from the Neon console (Connection Details → JDBC).
NEON_SYNC_URL=jdbc:postgresql://ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&options=endpoint%3Dep-xxxx
NEON_SYNC_USERNAME=neondb_owner
NEON_SYNC_PASSWORD=your_neon_password
